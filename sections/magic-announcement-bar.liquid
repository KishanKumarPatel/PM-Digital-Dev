{%- style -%}
  .magic-announcement-{{ section.id }} {
    background: {{ section.settings.bg_gradient | default: 'linear-gradient(90deg, #D8A4C3 0%, #E8C19E 100%)' }};
    color: {{ section.settings.text_color | default: '#1A1A1A' }};
    padding: 10px 16px;
    text-align: center;
    font-family: 'Circular Std', 'CircularStd', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
    width: 100%;
    box-sizing: border-box;
  }

  .magic-announcement-{{ section.id }} .magic-announcement__content {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    flex-wrap: wrap;
  }

  .magic-announcement-{{ section.id }} a {
    color: inherit;
    text-decoration: underline;
    font-weight: 700;
    transition: opacity 0.2s ease;
  }

  .magic-announcement-{{ section.id }} a:hover {
    opacity: 0.8;
  }
{%- endstyle -%}

<aside class="magic-announcement magic-announcement-{{ section.id }}" id="Announcement-{{ section.id }}" role="region" aria-label="Announcement">
  <div class="magic-announcement__content">
    <span>{{ section.settings.text | escape }}</span>
    {% if section.settings.link_text != blank %}
      <a href="{{ section.settings.link_url | default: '#' }}">
        {{ section.settings.link_text | escape }}
      </a>
    {% endif %}
  </div>
</aside>

{% schema %}
{
  "name": "Magic Announcement Bar",
  "tag": "aside",
  "class": "section-magic-announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "Last day. The MAXX 5-pack is free with your new subscription. Today only. →"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "default": "linear-gradient(90deg, #D8A4C3 0%, #E8C19E 100%)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1A1A1A"
    }
  ],
  "presets": [
    {
      "name": "Magic Announcement Bar"
    }
  ]
}
{% endschema %}
